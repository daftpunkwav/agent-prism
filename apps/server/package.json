{
  "name": "@agentprism/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent-prism-server": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "predev": "tsc -p tsconfig.json",
    "dev": "node --watch dist/main.js",
    "prestart": "tsc -p tsconfig.json",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@agentprism/application": "workspace:*",
    "@agentprism/arena-dimensions": "workspace:*",
    "@agentprism/arena-runner": "workspace:*",
    "@agentprism/builder-service": "workspace:*",
    "@agentprism/builder-turns": "workspace:*",
    "@agentprism/config": "workspace:*",
    "@agentprism/contracts": "workspace:*",
    "@agentprism/dimensions": "workspace:*",
    "@agentprism/driver-autogen": "workspace:*",
    "@agentprism/driver-claude-agent-sdk": "workspace:*",
    "@agentprism/driver-crewai": "workspace:*",
    "@agentprism/driver-deepagents": "workspace:*",
    "@agentprism/driver-langchain": "workspace:*",
    "@agentprism/driver-langgraph": "workspace:*",
    "@agentprism/driver-native": "workspace:*",
    "@agentprism/driver-openai-agents": "workspace:*",
    "@agentprism/driver-plan-execute": "workspace:*",
    "@agentprism/driver-run-support": "workspace:*",
    "@agentprism/driver-self-critique": "workspace:*",
    "@agentprism/evaluation": "workspace:*",
    "@agentprism/http-runtime": "workspace:*",
    "@agentprism/memory-episodic": "workspace:*",
    "@agentprism/memory-semantic": "workspace:*",
    "@agentprism/memory-service": "workspace:*",
    "@agentprism/memory-top-n": "workspace:*",
    "@agentprism/persistence": "workspace:*",
    "@agentprism/provider-catalog": "workspace:*",
    "@agentprism/provider-langchain": "workspace:*",
    "@agentprism/route-arena": "workspace:*",
    "@agentprism/route-builder": "workspace:*",
    "@agentprism/route-projects": "workspace:*",
    "@agentprism/route-provider": "workspace:*",
    "@agentprism/route-sessions": "workspace:*",
    "@agentprism/route-settings": "workspace:*",
    "@agentprism/route-threads": "workspace:*",
    "@agentprism/route-workspace": "workspace:*",
    "@agentprism/runtime": "workspace:*",
    "@agentprism/session-persistence": "workspace:*",
    "@agentprism/summary-budget": "workspace:*",
    "@agentprism/tool-builtins": "workspace:*",
    "@agentprism/tool-mcp": "workspace:*",
    "@agentprism/tool-replay": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@langchain/core": "^1.2.13",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@agentprism/session": "workspace:*",
    "@types/node": "^24"
  }
}
