{
  "name": "agent-prism",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --filter=!@agentprism/web --filter=!@agentprism/server build && pnpm -r typecheck && pnpm typecheck:tests",
    "boundaries": "node scripts/check-boundaries.mjs",
    "dev:server": "pnpm --filter @agentprism/server dev",
    "dev:web": "pnpm --filter @agentprism/web dev",
    "start:server": "pnpm --filter @agentprism/server start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "verify": "pnpm -r build && pnpm -r typecheck && pnpm typecheck:tests && pnpm --filter @agentprism/web lint && pnpm --filter @agentprism/web check:i18n && pnpm test:coverage && pnpm boundaries && pnpm check:deps && pnpm check:exports",
    "check:deps": "node scripts/check-package-deps.mjs",
    "check:exports": "node scripts/check-export-tests.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
